[Unit]
Description=RTC monitoring center and inventory UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=avops-monitor
Group=avops-monitor
EnvironmentFile=/etc/avops-monitor/center.env
ExecStart=/opt/avops-monitor/center
Restart=on-failure
RestartSec=5
StateDirectory=avops-monitor
StateDirectoryMode=0700
LogRateLimitIntervalSec=30s
LogRateLimitBurst=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/avops-monitor
MemoryMax=256M
CPUQuota=50%
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
