# Private config/agent.env comes from the center's generated config directory.
HOST_ADDRESS=198.51.100.20
CONFIG_DIR=./config
DATA_DIR=./data
CONTAINER_NAME=avops-agent
CPUS=1
MEMORY=512m
COLLECT_SECONDS=15
# Get the real value with: docker info --format '{{.DockerRootDir}}'
DOCKER_ROOT=/var/lib/docker
# Set both only when the center URL uses a domain requiring a fixed IP mapping.
CENTER_HOST=localhost
CENTER_IP=127.0.0.1
TLS_SERVER_NAME=
